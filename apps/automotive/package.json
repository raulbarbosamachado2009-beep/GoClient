{
  "name": "@goclient/automotive",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8082",
    "web": "expo start --web --port 8082",
    "android": "expo start --android --port 8082",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json",
    "preview:bundle": "expo export --platform web --output-dir dist && node scripts/single-file-preview.mjs",
    "test": "vitest run",
    "postinstall": "node scripts/vendor-maplibre.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@goclient/core": "workspace:*",
    "@goclient/design-tokens": "workspace:*",
    "@goclient/native": "workspace:*",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-navigation-bar": "~58.0.4",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "maplibre-gl": "5.24.1",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  }
}
