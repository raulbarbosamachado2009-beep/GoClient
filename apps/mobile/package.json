{
  "name": "@goclient/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@goclient/core": "workspace:*",
    "@goclient/design-tokens": "workspace:*",
    "@goclient/native": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
