# Ambiente: development | test | production
GOCLIENT_ENV=development
PORT=4000

# Banco de dados.
# Vazio em desenvolvimento: usa PGlite (PostgreSQL embutido) em apps/api/.data/pglite.
# Em produção: URL do PostgreSQL (ex.: Supabase, Neon, RDS).
DATABASE_URL=

# Autenticação: dev | jwt
# dev  -> usuário de desenvolvimento fixo (NUNCA em produção; a API recusa iniciar).
# jwt  -> valida tokens Bearer com o JWKS do provedor de identidade.
GOCLIENT_AUTH_MODE=dev
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Origens permitidas (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
