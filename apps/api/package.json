{
  "name": "@goclient/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API central do GoClient: autenticação, regras de negócio, sincronização, Havena e integrações.",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@goclient/core": "workspace:*",
    "@hono/node-server": "2.1.9",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.17",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  }
}
