{
  "name": "goclient",
  "private": true,
  "description": "GoClient — ecossistema de gestão comercial para representantes e vendedores externos.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@goclient/api --filter=@goclient/web",
    "dev:api": "pnpm --filter @goclient/api dev",
    "dev:web": "pnpm --filter @goclient/web dev",
    "dev:mobile": "pnpm --filter @goclient/mobile dev",
    "dev:automotive": "pnpm --filter @goclient/automotive dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @goclient/api db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "2.11.13",
    "typescript": "~6.0.3"
  }
}
